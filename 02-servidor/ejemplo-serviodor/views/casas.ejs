<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
    crossorigin="anonymous"
  >
</head>
<body>
  <div class="container py-4">
    <h1 class="mb-4"><%= title %></h1>

    <!-- Botones de navegación -->
    <div class="mb-3">
      <a href="/casas/mias" class="btn btn-primary">Ver mis casas</a>
      <a href="/casas" class="btn btn-secondary">Ver todas las casas</a>
    </div>

    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Valor</th>
          <th>Imagen</th>
          <th>Username</th>
        </tr>
      </thead>
      <tbody>
        <% casas.forEach(casa => { %>
          <tr>
            <td><%= casa.id %></td>
            <td><%= casa.nombre %></td>
            <td><%= casa.valor.toLocaleString() %></td>
            <td>
              <% if (casa.imagenURL) { %>
                <img
                  src="<%= casa.imagenURL %>"
                  alt="Imagen de <%= casa.nombre %>"
                  style="max-height: 60px;"
                >
              <% } else { %>
                —
              <% } %>
            </td>
            <td><%= casa.username ?? '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <a href="/auth/sesion" class="btn btn-link">Volver a sesión</a>
  </div>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
    crossorigin="anonymous"
  ></script>
</body>
</html>
