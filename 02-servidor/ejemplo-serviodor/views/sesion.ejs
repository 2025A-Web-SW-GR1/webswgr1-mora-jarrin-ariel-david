<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mi Sesión</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
    crossorigin="anonymous"
  >
</head>
<body>
  <% const arregloDeNumeros = [1,2,3,4,5]; %>

  <div class="container py-4">
    <h1 class="mb-4">Datos de Sesión</h1>

    <div class="row">
      <div class="col-sm-4"></div>
      <div class="col-sm-4">
        <% if (casa?.username) { %>
          <p><strong>Username:</strong> <%= casa.username %></p>
          <p><strong>Nombre de la casa:</strong> <%= casa.nombre %></p>

          <p><strong>Ejemplo de iteración:</strong></p>
          <ul>
            <% arregloDeNumeros.forEach(numero => { %>
              <li><%= numero %></li>
            <% }) %>
          </ul>
          <div class="mt-3">
            <a href="/casas/mias" class="btn btn-primary me-2">Ver mis casas</a>
            <a href="/casas" class="btn btn-secondary">Ver todas las casas</a>
          </div>
          <div class="mt-4">
            <a href="/auth/logout" class="btn btn-danger">Logout</a>
          </div>
        <% } %>
      </div>
      <div class="col-sm-4"></div>
    </div>
  </div>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
    crossorigin="anonymous"
  ></script>
</body>
</html>
